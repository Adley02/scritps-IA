import numpy as np

class MLPRegressor:
    def __init__(self, camadas_ocultas=(10,), ativacao='relu', taxa_aprendizado=0.01, epocas=1000):
        self.camadas_ocultas = camadas_ocultas
        self.ativacao = ativacao
        self.lr = taxa_aprendizado
        self.epocas = epocas
        
        self.pesos = []
        self.vieses = []

    # --- Funções de Ativação e suas Derivadas ---
    def _ativar(self, Z):
        if self.ativacao == 'sigmoid':
            Z = np.clip(Z, -500, 500) 
            return 1 / (1 + np.exp(-Z))
        elif self.ativacao == 'relu':
            return np.maximum(0, Z)

    def _derivada(self, A):
        if self.ativacao == 'sigmoid':
            return A * (1 - A)
        elif self.ativacao == 'relu':
            return np.where(A > 0, 1, 0)

    # --- Treinamento ---
    def fit(self, X, y):
        y = y.reshape(-1, 1) 
        n_amostras, n_atributos = X.shape
        
    
        tamanhos = [n_atributos] + list(self.camadas_ocultas) + [1]
        
      
        self.pesos = []
        self.vieses = []
        for i in range(len(tamanhos) - 1):
            # Inicialização "He" ou randômica padrão
            W = np.random.randn(tamanhos[i], tamanhos[i+1]) * 0.1
            b = np.zeros((1, tamanhos[i+1]))
            self.pesos.append(W)
            self.vieses.append(b)

      
        for epoca in range(self.epocas):
            
            
            ativacoes = [X]
            Zs = []
            
           
            for i in range(len(self.pesos) - 1):
                Z = np.dot(ativacoes[-1], self.pesos[i]) + self.vieses[i]
                A = self._ativar(Z)
                Zs.append(Z)
                ativacoes.append(A)
                
            
            Z_out = np.dot(ativacoes[-1], self.pesos[-1]) + self.vieses[-1]
            A_out = Z_out 
            Zs.append(Z_out)
            ativacoes.append(A_out)

           
            erro = A_out - y
            deltas = [erro] 
            
           
            for i in range(len(self.pesos) - 2, -1, -1):
                delta = np.dot(deltas[0], self.pesos[i+1].T) * self._derivada(ativacoes[i+1])
                deltas.insert(0, delta)

            
            for i in range(len(self.pesos)):
                gradiente_W = np.dot(ativacoes[i].T, deltas[i]) / n_amostras
                gradiente_b = np.sum(deltas[i], axis=0, keepdims=True) / n_amostras
                
                self.pesos[i] -= self.lr * gradiente_W
                self.vieses[i] -= self.lr * gradiente_b

    
    def predict(self, X):
        A = X
        
        for i in range(len(self.pesos) - 1):
            Z = np.dot(A, self.pesos[i]) + self.vieses[i]
            A = self._ativar(Z)
        
        # Última camada (Saída Linear)
        Z_out = np.dot(A, self.pesos[-1]) + self.vieses[-1]
        return Z_out.flatten() 
